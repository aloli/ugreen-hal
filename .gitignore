.DS_Store
*.pdf
*.bak

# Configuration Claude Code personnelle (permissions locales, machine de dev)
.claude/settings.local.json
.claude/.cc-writes/

# Artefacts locaux du banc QEMU : images disque de plusieurs Gio, clés SSH
# de test, journaux et binaires construits.
qemu/images/
qemu/run/
qemu/logs/
qemu/ssh/
qemu/build/

# Binaires construits par src/cli/Makefile
src/cli/ugreen-led-ctl
src/cli/*.o

# Clé privée du banc NAS physique (dédiée, distincte de la clé
# personnelle) — seule la clé publique doit être versionnée, embarquée
# dans scripts/systemrescue-restore.sh.
scripts/nas-ssh/id_ed25519

# Correspondance nom court -> IP du parc de test (scripts/nas-connect.cr).
# Propre à cette machine et à cette campagne : l'IP change à chaque
# redémarrage d'une unité (SystemRescue est un environnement live, sans
# état persistant). Un fichier committé serait faux dès le lendemain.
scripts/nas-hosts.json

# Artefacts locaux du banc QEMU Linux (compilation de scripts/led-probe/) :
# mêmes raisons que pour le banc QEMU FreeBSD ci-dessus.
scripts/led-probe/qemu/images/
scripts/led-probe/qemu/run/
scripts/led-probe/qemu/logs/
scripts/led-probe/qemu/ssh/
scripts/led-probe/led_probe

# Paquets de firmware UGOS téléchargés chez UGREEN : 1,75 Go par version, et
# surtout du code propriétaire qui n'a pas à être redistribué depuis un dépôt
# public sous licence BSD. Analysés localement, jamais versionnés — les
# conclusions vivent dans docs/hardware-notes.adoc.
firmware-ugreen/
